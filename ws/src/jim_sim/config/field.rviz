Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: [/RobotModel1, /Detections1, /Targeting1]
    Tree Height: 500
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.4
      Cell Size: 0.05
      Class: rviz_default_plugins/Grid
      Color: 130; 130; 135
      Enabled: true
      Line Style: {Line Width: 0.02, Value: Lines}
      Name: Grid
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: work_surface
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description Source: Topic
      Description Topic: {Value: /robot_description}
      Enabled: true
      Name: RobotModel
      Visual Enabled: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.06
      Name: TF
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Value: true
      Frames:
        All Enabled: false
        work_surface: {Value: true}
        laser_aim_link: {Value: true}
        base_link: {Value: true}
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Detections
      Namespaces: {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Value: /weeds/markers
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Targeting
      Namespaces: {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Value: /targeting/markers
      Value: true
  Fixed Frame: work_surface
  Global Options:
    Background Color: 40; 40; 44
    Fixed Frame: work_surface
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 0.75
      Focal Point: {X: 0, Y: 0, Z: 0}
      Name: Current View
      Pitch: 0.95
      Target Frame: work_surface
      Yaw: 4.2
    Saved: ~
Window Geometry: {Height: 900, Width: 1400}
