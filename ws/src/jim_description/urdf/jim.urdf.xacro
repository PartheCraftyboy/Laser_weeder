<?xml version="1.0"?>
<!--
  Jim - laser weed removal gantry
  2-DOF Cartesian XY positioner

  Derived from the SolidWorks URDF export, with these corrections:
    * joint_y origin shifted back by one full travel (the Y nut was
      exported fully extended instead of homed)
    * collision geometry replaced with primitives (mesh collision on
      167k triangles would destroy the Gazebo solver)
    * masses and inertias overridden (no materials were assigned in CAD,
      so the exporter's values were ~4x too low)
    * package renamed, robot renamed, ROS 2 structure
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="jim">

  <!-- ==================================================================
       ARGUMENTS  (override at launch: xacro jim.urdf.xacro use_sim:=false)
       ================================================================== -->
  <xacro:arg name="use_sim"     default="true"/>
  <xacro:arg name="params_file" default="$(find jim_bringup)/config/controllers.yaml"/>

  <!-- Height of base_link above the ground plane, metres. -->
  <xacro:property name="mount_height" value="0.30"/>

  <!-- ==================================================================
       PARAMETERS
       Everything tunable lives here. Change a number, rebuild, done.
       ================================================================== -->

  <!-- Mechanical travel, metres. Measured nut-face to end-support. -->
  <xacro:property name="travel_x" value="0.250"/>
  <xacro:property name="travel_y" value="0.250"/>

  <!-- Drivetrain. T8 lead screw, 2 mm pitch x 4 starts = 8 mm per rev.
       Not used by URDF directly - the hardware interface reads these to
       convert metres to steps. Kept here so there is one source of truth. -->
  <xacro:property name="screw_lead"   value="0.008"/>
  <xacro:property name="steps_per_rev" value="200"/>
  <xacro:property name="microsteps"    value="16"/>

  <!-- Velocity ceiling. Set by lead screw critical speed (whip), not by
       motor torque. 4.76e6 * 6.2 / 300^2 = 328 rpm, derated 80%, x 8 mm. -->
  <xacro:property name="max_vel" value="0.035"/>
  <xacro:property name="max_eff" value="50.0"/>

  <!-- Link masses, kg. Estimated - CAD had no materials assigned.
       Replace with weighed values before any dynamics work. -->
  <xacro:property name="mass_base" value="0.75"/>
  <xacro:property name="mass_xc"   value="0.90"/>
  <xacro:property name="mass_yc"   value="0.15"/>

  <!-- Joint origins straight from the CAD export. -->
  <xacro:property name="jx_xyz" value="0.073575 -0.018445 0.0064807"/>
  <xacro:property name="jx_rpy" value="3.14159265 0 0"/>

  <!-- Y origin CORRECTED: exporter gave 0.35117 (nut fully extended).
       Home is one full travel back from there. -->
  <xacro:property name="jy_y" value="${0.35117 - travel_y}"/>

  <xacro:property name="mesh" value="package://jim_description/meshes"/>

  <!-- ==================================================================
       MATERIALS
       ================================================================== -->
  <material name="jim_grey">  <color rgba="0.75 0.75 0.78 1.0"/></material>
  <material name="jim_gold">  <color rgba="0.95 0.76 0.18 1.0"/></material>
  <material name="jim_red">   <color rgba="0.85 0.15 0.15 1.0"/></material>

  <!-- ==================================================================
       INERTIA HELPER
       Solid cuboid about its own centre of mass. Good enough for
       position-controlled prismatic joints - the controller commands
       position, so inertia only shows up as second-order dynamics.
       ================================================================== -->
  <xacro:macro name="box_inertia" params="m x y z o_xyz">
    <inertial>
      <origin xyz="${o_xyz}" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia
        ixx="${m*(y*y + z*z)/12.0}" ixy="0.0" ixz="0.0"
        iyy="${m*(x*x + z*z)/12.0}" iyz="0.0"
        izz="${m*(x*x + y*y)/12.0}"/>
    </inertial>
  </xacro:macro>

  <!-- ==================================================================
       LINKS
       ================================================================== -->

  <!-- base_link: frame, X motor, X coupler, X screw, X guide rods,
       both X end brackets. Anything bolted down or merely spinning. -->
  <link name="base_link">
    <xacro:box_inertia m="${mass_base}" x="0.381" y="0.042" z="0.067"
                       o_xyz="0.1745 -0.0184 -0.0009"/>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${mesh}/base_link.stl"/></geometry>
      <material name="jim_grey"/>
    </visual>
    <collision>
      <origin xyz="0.1745 -0.0184 -0.0009" rpy="0 0 0"/>
      <geometry><box size="0.381 0.042 0.067"/></geometry>
    </collision>
  </link>

  <!-- x_carriage: X nut, its block, AND the entire Y axis assembly -
       Y motor, Y coupler, Y screw, Y rods, Y end bracket. All of it
       rides on X, so all of it belongs to this link. -->
  <link name="x_carriage">
    <xacro:box_inertia m="${mass_xc}" x="0.042" y="0.415" z="0.062"
                       o_xyz="-0.0119 0.1865 0.0009"/>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${mesh}/x_carriage.stl"/></geometry>
      <material name="jim_gold"/>
    </visual>
  </link>

  <!-- y_carriage: Y nut, its block, laser head. -->
  <link name="y_carriage">
    <xacro:box_inertia m="${mass_yc}" x="0.047" y="0.016" z="0.054"
                       o_xyz="-0.0154 0.007 0.0093"/>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${mesh}/y_carriage.stl"/></geometry>
      <material name="jim_gold"/>
    </visual>
  </link>

  <!-- laser_aim_link: where the beam leaves the head, pointing down.
       This is the frame targeting actually solves for. Z is the beam
       direction, so a target is "put laser_aim_link over that point".
       Offset is a placeholder - measure it off the real head. -->
  <link name="laser_aim_link"/>

  <joint name="laser_aim_joint" type="fixed">
    <origin xyz="-0.0154 0.007 0.0175" rpy="0 0 0"/>
    <parent link="y_carriage"/>
    <child  link="laser_aim_link"/>
  </joint>

  <!-- ==================================================================
       JOINTS
       ================================================================== -->

  <joint name="joint_x" type="prismatic">
    <origin xyz="${jx_xyz}" rpy="${jx_rpy}"/>
    <parent link="base_link"/>
    <child  link="x_carriage"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="${travel_x}"
           effort="${max_eff}" velocity="${max_vel}"/>
  </joint>

  <joint name="joint_y" type="prismatic">
    <origin xyz="0.0005 ${jy_y} -0.004" rpy="0 0 0"/>
    <parent link="x_carriage"/>
    <child  link="y_carriage"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="${travel_y}"
           effort="${max_eff}" velocity="${max_vel}"/>
  </joint>

  <!-- ==================================================================
       WORLD ANCHOR
       Gazebo treats a link literally named "world" as the static frame.
       Without this the gantry is a free body and falls through the floor.
       It also gives the kinematic tree an inertia-free root, which is
       what silences the KDL "root link has inertia" warning.
       ================================================================== -->
  <link name="world"/>

  <joint name="world_to_base" type="fixed">
    <origin xyz="0 0 ${mount_height}" rpy="0 0 0"/>
    <parent link="world"/>
    <child  link="base_link"/>
  </joint>

  <!-- ==================================================================
       CONTROL
       ================================================================== -->
  <xacro:include filename="$(find jim_description)/urdf/jim.ros2_control.xacro"/>

  <xacro:jim_ros2_control
      use_sim="$(arg use_sim)"
      travel_x="${travel_x}"
      travel_y="${travel_y}"
      max_vel="${max_vel}"
      params_file="$(arg params_file)"/>

</robot>
